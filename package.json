{
  "name": "ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "api:dev": "pnpm --filter @ecommerce/api dev",
    "web:dev": "pnpm --filter @ecommerce/web dev",
    "mobile:dev": "pnpm --filter @ecommerce/mobile start",
    "db:push": "echo \"Schema is applied automatically on API start\"",
    "db:seed": "pnpm --filter @ecommerce/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.19.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
