@echo off
REM ShopMart database backup - dumps all tables to backups\ecommerce-YYYYMMDD-HHMMSS.sql
powershell -NoProfile -ExecutionPolicy Bypass -Command "$b = 'C:\projects\ecommerce\backups'; New-Item -ItemType Directory -Force $b | Out-Null; $stamp = Get-Date -Format 'yyyyMMdd-HHmmss'; $out = Join-Path $b ('ecommerce-' + $stamp + '.sql'); $p = Start-Process 'C:\xampp\mysql\bin\mysqldump.exe' -ArgumentList '-u root --single-transaction --routines --triggers ecommerce' -RedirectStandardOutput $out -Wait -PassThru -NoNewWindow; if ($p.ExitCode -ne 0) { Write-Output ('BACKUP FAILED (exit ' + $p.ExitCode + ')'); exit 1 }; Write-Output ('Backup written to: ' + $out); Get-ChildItem ($b + '\ecommerce-*.sql') | Sort-Object LastWriteTime -Descending | Select-Object -Skip 14 | Remove-Item -Force"
